# NoneBot server
HOST=127.0.0.1
PORT=8080
DRIVER=~fastapi+~httpx+~websockets

# OneBot v11
ONEBOT_ACCESS_TOKEN=

# AI model: DeepSeek uses an OpenAI-compatible API.
# OPENAI_* names are ignored; migrate explicitly to AIKE_LLM_*.
# Process variables override .env at import; .env edits require a process restart.
AIKE_LLM_API_KEY=your_deepseek_api_key
AIKE_LLM_BASE_URL=https://api.deepseek.com
AIKE_LLM_MODEL=deepseek-v4-flash
# DeepSeek chat only: low/high/max. Planners and scene-specific overrides stay separate.
AIKE_LLM_REASONING_EFFORT=high
AI_TEMPERATURE=0.7
AIKE_LLM_TIMEOUT_SECONDS=60
# Use DeepSeek Function Calling to verify uncertain public expressions via Moegirlpedia.
# This only affects the current chat turn and is enabled by default.
ENABLE_UNKNOWN_SLANG_TOOL=true
# Shared encyclopedia graph. Linyin prepares evidence before one persona reply.
ENABLE_AIKE_ENCYCLOPEDIA=true
ENABLE_LINYIN_ENCYCLOPEDIA=true
LINYIN_ENCYCLOPEDIA_AUTO=true
# Whole planner / lookup budgets, not individual HTTP-request timeouts.
ENCYCLOPEDIA_PLAN_TIMEOUT_SECONDS=8
ENCYCLOPEDIA_LOOKUP_TIMEOUT_SECONDS=8

# v1.3 Agent runtime / MainAgentGraph.
# ENABLE_MAIN_AGENT opens the QQ /agent entry.
# MAIN_AGENT_USE_LLM lets /agent use the real Main LLM to generate ActionRequest JSON.
# Formal work reports are read-local: development context and deterministic system overview.
# Registered owner writes still require approval; no shell, arbitrary file write, or unregistered DB write is exposed.
ENABLE_MAIN_AGENT=false
MAIN_AGENT_USE_LLM=false
MAIN_AGENT_OWNER_ONLY=true
MAIN_AGENT_ALLOW_GROUP=false
MAIN_AGENT_MAX_STEPS=5
MAIN_AGENT_REQUIRE_APPROVAL_FOR_WRITES=true
ENABLE_AGENT_WEB=false
# Reserved fixed provider configuration. A Key alone does not enable networking;
# production wiring remains absent until the external-read rollout is approved.
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=10
ENABLE_AGENT_LOCAL_WRITE=false
ENABLE_AGENT_EXTERNAL_WRITE=false
ENABLE_AGENT_SHELL=false

# Optional local Web Owner Console static page serving.
# Keep disabled by default; when true, build web/owner-console first.
OWNER_CONSOLE_STATIC_ENABLED=false
OWNER_CONSOLE_STATIC_DIR=web/owner-console/dist
OWNER_CONSOLE_APPROVAL_ACTIONS_ENABLED=false
OWNER_CONSOLE_TASK_ACTIONS_ENABLED=false

# MainAgent model. Keep MAIN_LLM_API_KEY out of Git.
# MAIN_LLM_BASE_URL should be an OpenAI-compatible API Base URL, for example https://api.example.com/v1.
MAIN_LLM_API_KEY=
MAIN_LLM_BASE_URL=
MAIN_LLM_MODEL=gpt-5.5
MAIN_LLM_TIMEOUT_SECONDS=60

# Compatibility fields, currently unused by production chat and health probes.
# ChatGraph changes execution flow only; chat uses AIKE_LLM_* or an explicitly
# allowlisted PERSONA_LLM_* route. Do not copy credentials here to enable ChatGraph.
CHAT_LLM_API_KEY=
CHAT_LLM_BASE_URL=https://api.deepseek.com
CHAT_LLM_MODEL=deepseek-v4-flash
CHAT_LLM_TIMEOUT_SECONDS=60
# Select execution flow only; this does not change the effective model route.
ENABLE_CHAT_GRAPH_RUNTIME=false

# Aike/legacy summary model. This is intentionally independent from both
# AIKE_LLM_* and CHAT_LLM_*; an empty key fails closed and keeps original messages.
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_BASE_URL=https://api.deepseek.com
SUMMARY_LLM_MODEL=deepseek-v4-flash
SUMMARY_LLM_TIMEOUT_SECONDS=60

# Optional per-persona chat endpoint. Disabled by default and affects only
# normal replies whose role card key is explicitly allowlisted. Summaries,
# memory compression, MainAgent, vision, stickers, and the legacy Aike route
# continue using their existing providers. Disable the flag for instant rollback.
ENABLE_PERSONA_LLM_ROUTING=false
PERSONA_LLM_ROLE_CARD_KEYS=
PERSONA_LLM_PROVIDER=openai
PERSONA_LLM_API_KEY=
PERSONA_LLM_BASE_URL=
PERSONA_LLM_MODEL=
PERSONA_LLM_TIMEOUT_SECONDS=60
PERSONA_LLM_NUM_CTX=4096
PERSONA_LLM_MAX_TOKENS=640
# Use 0 for an 8 GB GPU shared with local TTS. Ollama unloads after each reply.
PERSONA_LLM_KEEP_ALIVE_SECONDS=0

# Optional image-recognition override for explicitly allowlisted role cards.
# For DeepSeek, omit API_KEY/BASE_URL to inherit AIKE_LLM credentials/endpoint.
# An explicitly empty DeepSeek override remains unconfigured. Other models
# inherit PERSONA_LLM values for backward compatibility; set explicitly when
# persona chat uses local Ollama. The route
# does not fall back silently when vision fails. Legacy/Aike images stay on Bailian.
ENABLE_PERSONA_VISION_ROUTING=false
PERSONA_VISION_ROLE_CARD_KEYS=
PERSONA_VISION_API_KEY=
PERSONA_VISION_BASE_URL=
PERSONA_VISION_MODEL=
PERSONA_VISION_TIMEOUT_SECONDS=90
# Leave blank to use 4096 for DeepSeek, 400 for other models.
PERSONA_VISION_MAX_TOKENS=
# DeepSeek-only thinking strength; independent of both characters' chat settings.
PERSONA_VISION_REASONING_EFFORT=high
# Optional per-persona image-only wait. It applies only to role cards listed in
# PERSONA_VISION_ROLE_CARD_KEYS; -1 keeps the legacy VISION_PRIVATE_IMAGE_WAIT_SECONDS.
PERSONA_VISION_PRIVATE_IMAGE_WAIT_SECONDS=-1

# Owner-private explicit image generation/editing. Disabled by default.
# Empty API_KEY/BASE_URL reuse PERSONA_LLM_API_KEY/PERSONA_LLM_BASE_URL.
# /生成图片 calls IMAGE_GEN_MODEL once. /修改图片 stores the instruction in
# process memory, then consumes the owner's next private image within the TTL.
# IMAGE_EDIT_MODEL defaults to IMAGE_GEN_MODEL when it is left empty in a real
# .env. The default model name is provider-specific and must be supported by
# the configured OpenAI-compatible image endpoint.
# Neither path writes chat history, summaries, memory, RAG, or SceneHub state.
ENABLE_IMAGE_GEN=false
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_MODEL=grok-imagine-image-quality
IMAGE_EDIT_MODEL=grok-imagine-image-quality
IMAGE_GEN_TIMEOUT_SECONDS=120
IMAGE_GEN_MAX_PROMPT_CHARS=1000
IMAGE_GEN_MAX_INPUT_BYTES=10485760
IMAGE_GEN_MAX_OUTPUT_BYTES=10485760
IMAGE_GEN_PENDING_EDIT_SECONDS=120
IMAGE_GEN_COOLDOWN_SECONDS=30
IMAGE_GEN_MAX_REQUESTS_PER_HOUR=10

# Optional owner-private Qwen LoRA editor backed by the public Hugging Face
# ZeroGPU Space. It is separate from /生成图片 and /修改图片. /Qwen改图
# accepts one image in the first version; inference is never retried, while a
# completed result may be downloaded again with /重取改图.
ENABLE_QWEN_SPACE_EDIT=false
QWEN_SPACE_BASE_URL=https://prithivmlmods-qwen-image-edit-2511-loras-fast.hf.space
# Optional. A free Hugging Face token gives the signed-in account quota and
# queue priority. Keep this empty to use the anonymous ZeroGPU quota.
QWEN_SPACE_HF_TOKEN=
QWEN_SPACE_SUBMIT_TIMEOUT_SECONDS=60
QWEN_SPACE_INFER_TIMEOUT_SECONDS=180
QWEN_SPACE_DOWNLOAD_TIMEOUT_SECONDS=300
QWEN_SPACE_DOWNLOAD_RETRIES=2
QWEN_SPACE_RESULT_TTL_SECONDS=1800
QWEN_SPACE_MAX_SIDE=1024
QWEN_SPACE_JPEG_QUALITY=90

# Narrow Chatbot weather capability. This never routes through MainAgent or Tavily.
# Start with shadow, then owner_explicit, and only use owner_auto after validation.
ENABLE_CHAT_WEATHER=false
CHAT_WEATHER_MODE=off
CHAT_WEATHER_PROVIDER=open_meteo
CHAT_WEATHER_DEFAULT_LOCATION=
CHAT_WEATHER_DEFAULT_LATITUDE=0
CHAT_WEATHER_DEFAULT_LONGITUDE=0
CHAT_WEATHER_TIMEOUT_SECONDS=5

# Vision model: qwen3.7-flash on Aliyun Bailian Beijing is the production provider.
# Images entering describe_images() are sent to this external provider.
ENABLE_VISION=true
# Owner-managed private values. Never commit real credentials.
ALIYUN_BAILIAN_BASE_URL=
ALIYUN_BAILIAN_API_KEY=
# Legacy local Ollama settings are retained for historical local diagnostics only.
# scripts/start.ps1 does not check or start this vision model. Ollama ensure is reserved
# for enabled MemoryRAG/ProjectDocRAG when MEMORY_RAG_EMBEDDING_PROVIDER=ollama.
VISION_OLLAMA_BASE_URL=http://127.0.0.1:11434
VISION_MODEL=qwen2.5vl:3b
VISION_TIMEOUT_SECONDS=180
VISION_NUM_CTX=16384
VISION_MAX_IMAGES=1
VISION_MAX_IMAGE_BYTES=5242880
# Semicolon-separated trusted NapCat/QQ image-cache roots. Empty fails closed:
# local paths and file:// image sources are rejected. Environment placeholders
# such as %USERPROFILE% are supported.
VISION_TRUSTED_LOCAL_ROOTS=
VISION_IMAGE_CACHE_TTL_SECONDS=120
VISION_PRIVATE_IMAGE_WAIT_SECONDS=5

# Local sticker inspection, owner approval, and owner-private explicit preview.
# Preview sends at most one approved+enabled local asset per strict command.
# It does not enable normal-chat attachments or any automatic sending.
ENABLE_LOCAL_STICKERS=false
LOCAL_STICKER_MAX_FILE_BYTES=2097152
LOCAL_STICKER_MAX_DYNAMIC_FILE_BYTES=5242880
LOCAL_STICKER_MIN_DIMENSION=32
LOCAL_STICKER_MAX_DIMENSION=2048
LOCAL_STICKER_MAX_PIXELS=4194304
LOCAL_STICKER_MAX_ANIMATION_FRAMES=120
LOCAL_STICKER_MAX_ANIMATION_DURATION_MS=10000
LOCAL_STICKER_MIN_FRAME_DURATION_MS=20
LOCAL_STICKER_MAX_ANIMATION_DECODED_PIXELS=60000000
LOCAL_STICKER_PREVIEW_COOLDOWN_SECONDS=3

# B1 shadow intent only. Shadow parses a finite ChatAgent suggestion and runs
# local selection gates, but never sends a sticker. Automatic attachments stay
# separately disabled until a later owner-approved B2 live rollout.
ENABLE_CHAT_STICKER_INTENT_SHADOW=false
ENABLE_CHAT_STICKER_ATTACHMENTS=false

# Decoupled remote sticker classifier. It uses a separate API key and runs only
# after a complete owner-private text reply was sent. It never falls back to the
# ChatAgent key, never changes the reply, and remains shadow-only here.
ENABLE_REMOTE_STICKER_CLASSIFIER=false
STICKER_CLASSIFIER_BASE_URL=https://api.deepseek.com
STICKER_CLASSIFIER_API_KEY=
STICKER_CLASSIFIER_MODEL=deepseek-v4-flash
STICKER_CLASSIFIER_TIMEOUT_SECONDS=8
STICKER_CLASSIFIER_MAX_INPUT_CHARS=2400
CHAT_STICKER_OWNER_PRIVATE_ONLY=true
CHAT_STICKER_COOLDOWN_SECONDS=120
CHAT_STICKER_MIN_MESSAGES_BETWEEN=4
CHAT_STICKER_MAX_PER_HOUR=6
CHAT_STICKER_MAX_PER_REPLY=1
CHAT_STICKER_MIN_INTENT_CONFIDENCE=0.82

# Bot behavior
BOT_NAME=AI助手
BOT_ALIASES=
BOT_OWNER_QQ=
BOT_OWNER_PUBLIC_NAME=
BOT_TIMEZONE=Asia/Shanghai
ENABLE_PRIVATE_CHAT=true
ENABLE_GROUP_CHAT=true

# Optional V1 shared SceneHub for exactly one owner+Aike+Linyin QQ group.
# Disabled and fail-closed by default. Put all real QQ IDs and credentials only
# in the local .env. Qwen and DeepSeek are manual alternatives; there is no
# automatic provider fallback or retry.
ENABLE_SHARED_SCENE_HUB=false
SHARED_SCENE_GROUP_ID=
SHARED_SCENE_AIKE_BOT_ID=
SHARED_SCENE_LINYIN_BOT_ID=
SCENE_DIRECTOR_PROVIDER=qwen
SCENE_DIRECTOR_API_KEY=
SCENE_DIRECTOR_BASE_URL=
SCENE_DIRECTOR_MODEL=
SCENE_DIRECTOR_TIMEOUT_SECONDS=15
SCENE_DIRECTOR_CIRCUIT_SECONDS=120
SCENE_MAX_CONTEXT_EVENTS=20
SCENE_DIRECTOR_CONTEXT_EVENTS=6
# SceneHub keeps replies conversational while retaining a finite hard cap.
SCENE_MAX_REPLY_SENTENCES=3
SCENE_MAX_REPLY_CHARS=160
SCENE_ACTOR_MAX_TOKENS=256
# Each actor reads only its own owner-private continuity; group turns never write back.
SCENE_PRIVATE_CONTEXT_MAX_MESSAGES=12
SCENE_PRIVATE_CONTEXT_MAX_SUMMARIES=2
SCENE_PRIVATE_CONTEXT_MAX_GAP_SUMMARIES=1
SCENE_PRIVATE_CONTEXT_MAX_MANUAL_MEMORIES=8
SCENE_PRIVATE_CONTEXT_MAX_CHARS=2400
SCENE_MEMBER_CACHE_SECONDS=30
SCENE_MAX_PENDING_TURNS=1

MAX_CONTEXT_MESSAGES=40
ENABLE_MEMORY_COMPRESSION=true
MAX_STORED_MESSAGES_PER_SESSION=120
SUMMARY_KEEP_RECENT_MESSAGES=40
SUMMARY_BATCH_MESSAGES=80
SUMMARY_MIN_SOURCE_MESSAGES=40
MAX_SESSION_SUMMARIES_IN_CONTEXT=3
# Separate Bilibili background: latest 3 rounds + at most 5 older messages.
# Estimates include time labels/wrapper; never trim QQ history for this budget.
BILIBILI_HISTORY_ENABLED=true
BILIBILI_HISTORY_RAG_ENABLED=true
BILIBILI_BACKGROUND_MAX_TOKENS=1200
BILIBILI_BACKGROUND_QQ_RATIO=0.20
# Live gap card: first write after 25 overflow messages, then refresh every 20; only 1 card.
# GAP_SCENE_SUMMARY_1_THRESHOLD / _2_THRESHOLD are leftover and unused by the scheduler.
ENABLE_GAP_SCENE_SUMMARIES=true
GAP_SCENE_SUMMARY_1_THRESHOLD=40
GAP_SCENE_SUMMARY_2_THRESHOLD=80
MAX_GAP_SCENE_SUMMARIES_IN_CONTEXT=2
ENABLE_LONG_TERM_MEMORY_CONTEXT=true

# Owner-private topic/scene switch (archive short-term scene, keep LTM)
ENABLE_TOPIC_SCENE_SWITCH=true
TOPIC_SCENE_SWITCH_OWNER_ONLY=true
TOPIC_SCENE_SWITCH_PRIVATE_ONLY=true
TOPIC_SCENE_MIN_SOURCE_MESSAGES=4
TOPIC_SCENE_HINT_TURNS=3

# Owner-private chat bubble split. Default off; fail closed to one message.
ENABLE_CHAT_BUBBLE_SPLIT=false
CHAT_BUBBLE_SPLIT_OWNER_PRIVATE_ONLY=true
CHAT_BUBBLE_MIN_DELAY_MS=700
CHAT_BUBBLE_MAX_DELAY_MS=1200
CHAT_BUBBLE_MAX_BUBBLES=3

# Owner-private reunion after a real time gap. Not a topic switch.
ENABLE_CHAT_REUNION=true
CHAT_REUNION_OWNER_PRIVATE_ONLY=true
CHAT_REUNION_MIN_GAP_HOURS=3
MAX_LONG_TERM_MEMORIES_IN_CONTEXT=8
RULE_REMINDER_INTERVAL_MESSAGES=40

# Local RAG embedding. Set NUM_GPU=0 to keep bge-m3 on CPU and reserve VRAM
# for independent local workloads such as IndexTTS. Use -1 for Ollama auto.
ENABLE_MEMORY_RAG=false
ENABLE_PROJECT_DOC_RAG=false
MEMORY_RAG_EMBEDDING_PROVIDER=ollama
MEMORY_RAG_EMBEDDING_MODEL=bge-m3
MEMORY_RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434
MEMORY_RAG_EMBEDDING_DIMENSION=1024
MEMORY_RAG_EMBEDDING_TIMEOUT_SECONDS=60
MEMORY_RAG_EMBEDDING_NUM_GPU=0

# Access control
PRIVATE_WHITELIST=
ALLOW_UNKNOWN_PRIVATE_CHAT=false
PRIVATE_TRIAL_MESSAGES=3
PRIVATE_RATE_LIMIT_SECONDS=10
MAX_PRIVATE_MESSAGE_LENGTH=150
# Owner-only private-chat override. 0 disables the application-level limit.
OWNER_MAX_PRIVATE_MESSAGE_LENGTH=0

GROUP_WHITELIST=
GROUP_RATE_LIMIT_SECONDS=5
MAX_GROUP_MESSAGE_LENGTH=300
ENABLE_GROUP_AUTO_REPLY=false
GROUP_AUTO_REPLY_THRESHOLD=50
GROUP_AUTO_REPLY_COOLDOWN_SECONDS=60
GROUP_AUTO_REPLY_OWNER_COOLDOWN_SECONDS=30
GROUP_AUTO_REPLY_USER_COOLDOWN_SECONDS=120
ENABLE_OWNER_NOTIFICATIONS=true
OWNER_NOTIFICATION_MAX_LENGTH=50
OWNER_NOTIFICATION_GLOBAL_COOLDOWN_SECONDS=60
OWNER_NOTIFICATION_GROUP_COOLDOWN_SECONDS=120
OWNER_NOTIFICATION_USER_COOLDOWN_SECONDS=300

USER_BLACKLIST=

# Voice output / local TTS
ENABLE_TTS=false
TTS_SERVICE_URL=http://127.0.0.1:7861
TTS_VOICE=zh_kelin_raw_20260625_222137
TTS_EMOTION=affection
TTS_TIMEOUT_SECONDS=180
# Pre-generation text cap. The generated record is still hard-limited below.
TTS_MAX_CHARS=260
TTS_MAX_TOTAL_SECONDS=60
TTS_COOLDOWN_SECONDS=20
TTS_AUTO_START=true
TTS_STARTUP_WAIT_SECONDS=45

# Persona V2: Linyin has an independent local reference voice.  The voice ID
# is the selected file name without .wav under voice-samples/reference/zh/.
# Keep disabled until the bot has been restarted with this configuration.
ENABLE_LINYIN_TTS=false
LINYIN_TTS_VOICE=zh_kelin_raw_20260625
LINYIN_TTS_EMOTION=affection

# NapCatQQ
# Optional: set one QQ number to skip multi-account selection.
NAPCAT_QQ=

# Fixed identity for every bot account. V2 allowlists select storage/runtime
# mode only; the legacy account keeps its existing model and memory namespace.
# Routed-persona persistent memory is supported; enable only with explicit bot allowlists.
ENABLE_PERSONA_ROUTING_V2=false
ENABLE_PERSONA_MEMORY_V2=false
# Explicit comma-separated bot account allowlists; empty means no account.
PERSONA_ROUTING_V2_BOT_IDS=
PERSONA_MEMORY_V2_BOT_IDS=
# Only an explicit binding matching this identity may use legacy storage.
LEGACY_PERSONA_ID=aike
LEGACY_ROLE_CARD_KEY=aike
# Semicolon-separated: bot_self_id=persona_id:role_card_key. Routing fails
# closed for any unbound account, unavailable role card or invalid combination.
# 必填：每个运行账号固定一个人格和角色卡；运行时选择角色卡已关闭。
# 示例：2000000001=aike:aike;3000000001=linyin:linyin（请替换为部署账号）。
# 爱可保留旧版记忆；其他人格必须启用对应 V2 路由，不会回落默认库。
BOT_PERSONA_BINDINGS=

# Retrieval policy (disabling a source preserves stored data).
MEMORY_RAG_TOP_K=5
MEMORY_RAG_MIN_SCORE=0.55
MEMORY_RAG_MAX_CONTEXT_CHARS=1600
PROJECT_DOC_RAG_TOP_K=4
PROJECT_DOC_RAG_MIN_SCORE=0.50
PROJECT_DOC_RAG_MAX_CONTEXT_CHARS=2000
MEMORY_RAG_INCLUDE_MANUAL_FACTS=true
MEMORY_RAG_INCLUDE_MANUAL_PREFERENCES=true
MEMORY_RAG_INCLUDE_SESSION_SUMMARIES=true
MEMORY_RAG_INCLUDE_SHORT_MESSAGES=false
MEMORY_RAG_INCLUDE_GAP_SCENE_SUMMARIES=false
MEMORY_RAG_OWNER_ONLY_DEBUG=true
MEMORY_RAG_INJECT_IN_CHAT=false
