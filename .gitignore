# Environment and secrets
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Node.js
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
web/owner-console/dist/
web/owner-console/.vite/

# Runtime data
logs/*
!logs/.gitkeep
data/*
!data/.gitkeep

# Persona cards: deny everything by default. Only documentation, explicitly
# desensitized example templates, and the private-directory placeholder may be tracked.
prompts/persona-cards/**
!prompts/persona-cards/README.md
!prompts/persona-cards/public/
!prompts/persona-cards/public/*.example.md
!prompts/persona-cards/public/*.example.auto-reply.json
!prompts/persona-cards/private/
!prompts/persona-cards/private/.gitkeep

# Shared world cards: local relationship facts must never be committed.
prompts/world-cards/**
!prompts/world-cards/README.md
!prompts/world-cards/private/
!prompts/world-cards/private/.gitkeep

# Private style examples may contain persona-specific language and must never
# be committed. SceneHub loads them locally at runtime only.
prompts/style-examples/**

# Local tools
tools/

# Local backups
backups/
docs-archive/

# Local validation artifacts
tts-validation/
voice-samples/
temp_audio/
output/main-agent-workspace/
output/reliability-inspections/

# Local editor files
.vscode/
.idea/
*.swp
*.tmp

# Local Codex work-continuity checkpoints (never commit)
.codex/work-progress/

# OS files
Thumbs.db
.DS_Store
